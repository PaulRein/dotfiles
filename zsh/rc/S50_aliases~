alias du="du -hcs"
alias df="df -h"

if ( ls --version  >/dev/null 2>/dev/null ); then
	alias ls="ls --color=auto"
	alias la="ls --color=always -a"
	alias ll="ls --color=always --time-style=long-iso -laF"
elif ( which exa >/dev/null 2>/dev/null ); then
	alias ls="exa --color=auto"
	alias la="exa --color=always -aa"
	alias ll="exa --color=always --time-style=long-iso -laaF"
elif ( which gls >/dev/null 2>/dev/null ); then
	alias ls="gls --color=auto"
	alias la="gls --color=always -a"
	alias ll="gls --color=always --time-style=long-iso -laF"
else
	alias la="ls -a"
	alias ll="ls -laF"
fi

alias rm='rm -i'
alias mv='mv -i'

#alias ymd=yyyymmdd
#alias ymd-hms=yyyymmdd-hhmmss

if [[ $(uname) == 'Darwin' ]] then
	alias airport='/System/Library/PrivateFrameworks/Apple80211.framework/Versions/A/Resources/airport'
fi

if ( which aspell >/dev/null 2>/dev/null ) ; then
	alias spell_gb='aspell --master=en_GB-ize-w_accents --size=90 --encoding=utf-8 check'
	alias spell_sv='aspell --lang=sv --size=90 --encoding=utf-8 -C check'
fi

if ( which a2ps >/dev/null 2>/dev/null ) ; then
	alias pv='a2ps --prologue=standard -MA4 -s2 -Asheet -E -1 --delegate=no '
fi

if ( which wget >/dev/null 2>/dev/null ) ; then
